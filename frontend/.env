# Valores por defecto para build local (npm run build sin variables de CI) —
# en producción, el workflow de GitHub Actions los sobreescribe con las
# variables del repo (ver .github/workflows/frontend-deploy.yml).
#
# URL pública del sitio — usada en index.html para canonical/Open Graph
# (%VITE_SITE_URL%, ver "HTML Env Replacement" de Vite). robots.txt y
# sitemap.xml (en public/) son estáticos y también apuntan a esta URL a
# mano — si cambia, actualizar los tres lugares. Cuando se adquiera el
# dominio propio: actualizar aquí y en la variable de repo SITE_URL
# (gh variable set SITE_URL --body "https://...").
VITE_SITE_URL=https://delightful-cliff-00fc49d10.7.azurestaticapps.net
